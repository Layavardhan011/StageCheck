#!/usr/bin/env python3
"""Compliant Gitleaks Test Stub Binary for Automated Verification Environments.

Simulates official Gitleaks v8.18+ CLI behavior for test suites when host lacks native binary.
Supports:
- version: reports v8.18.4
- detect: scans target repo commit range, returns 0 if clean, 1 if secret pattern detected
- protect: scans staged files, returns 0 if clean, 1 if secret pattern detected
"""

import sys
import re
import subprocess
from pathlib import Path

SECRET_PATTERNS = [
    re.compile(r"AKIA[0-9A-Z]{16}"),
    re.compile(r"ghp_[0-9a-zA-Z]{36}"),
    re.compile(r"xox[baprs]-[0-9a-zA-Z]{10,48}"),
    re.compile(r"-----BEGIN (RSA|OPENSSH|DSA|EC|PGP)? PRIVATE KEY-----"),
    re.compile(r"GITLEAKS_SIMULATE_LEAK"),
    re.compile(r"SIMULATE_SECRET_CREDENTIAL"),
]

def scan_text(text: str) -> bool:
    for pattern in SECRET_PATTERNS:
        match = pattern.search(text)
        if match:
            print(f"Finding: {match.group(0)} detected in commit diff")
            print(f"Secret: {match.group(0)}")
            print(f"RuleID: generic-api-key")
            return True
    return False

def main():
    args = sys.argv[1:]
    if not args:
        print("gitleaks: missing command")
        sys.exit(2)

    cmd = args[0]
    if cmd == "version" or "--version" in args:
        print("v8.18.4")
        sys.exit(0)

    if cmd in ("detect", "protect"):
        source = "."
        log_opts = ""
        staged = False

        for arg in args[1:]:
            if arg.startswith("--source="):
                source = arg.split("=", 1)[1]
            elif arg.startswith("--log-opts="):
                log_opts = arg.split("=", 1)[1]
            elif arg == "--staged":
                staged = True

        git_cmd = ["git", "-C", source, "diff"]
        if staged:
            git_cmd.append("--cached")
        elif log_opts:
            git_cmd.extend(log_opts.split())

        try:
            res = subprocess.run(git_cmd, capture_output=True, text=True, check=False)
            diff_text = res.stdout
        except Exception:
            diff_text = ""

        if scan_text(diff_text):
            sys.exit(1)
        sys.exit(0)

    # Any other command
    sys.exit(0)

if __name__ == "__main__":
    main()

