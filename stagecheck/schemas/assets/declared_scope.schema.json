{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StageCheck Declared Scope Schema",
  "type": "object",
  "required": ["schema_version", "task_id", "allowed_paths"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["2.0"]
    },
    "task_id": {
      "type": "string",
      "pattern": "^task-[a-zA-Z0-9_-]+$"
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "read_only_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
