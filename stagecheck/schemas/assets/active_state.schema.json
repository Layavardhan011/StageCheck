{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StageCheck Active State Governance Schema",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "phase",
    "attempt_index",
    "repair_index",
    "max_total_attempts",
    "max_repairs",
    "circuit_breaker_tripped",
    "target_repositories"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["2.0"]
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "UNINITIALIZED",
        "IDLE",
        "PHASE_1_PLANNING",
        "PHASE_1_REPAIR",
        "PHASE_2A_CODING",
        "PHASE_2A_IMPLEMENTATION",
        "PHASE_2B_COMMITTING",
        "PHASE_2B_DELIVERY",
        "PHASE_3_AUDIT",
        "PHASE_3_AUDITING",
        "GATE_4_SEALING",
        "SEALED_PASSED",
        "AWAITING_HUMAN_DISPOSITION",
        "CIRCUIT_BREAKER_TRIPPED",
        "ABORTED",
        "COMPLETED"
      ]
    },
    "attempt_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "repair_index": {
      "type": "integer",
      "minimum": 0
    },
    "max_total_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "max_repairs": {
      "type": "integer",
      "minimum": 1
    },
    "circuit_breaker_tripped": {
      "type": "boolean"
    },
    "single_agent_mode": {
      "type": "boolean"
    },
    "halt_reason": {
      "type": ["string", "null"]
    },
    "target_repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9._-]+$"
      }
    },
    "resets_authorized": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "authorized_by", "from_attempt", "to_attempt"],
        "properties": {
          "timestamp": {"type": "string"},
          "authorized_by": {"type": "string"},
          "from_attempt": {"type": "integer"},
          "to_attempt": {"type": "integer"}
        }
      }
    },
    "registered_agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,62}$"
          },
          "role": {
            "type": "string",
            "enum": ["prompt_and_audit", "code_implementation", "dual_role"]
          },
          "instruction": {"type": "string"},
          "comment": {"type": "string"},
          "enabled": {"type": "boolean"}
        }
      }
    },
    "protected": {
      "type": "object",
      "properties": {
        "governance_version": {"type": "integer"},
        "max_total_attempts": {"type": "integer"},
        "max_repairs": {"type": "integer"},
        "circuit_breaker_enabled": {"type": "boolean"},
        "single_agent_mode": {"type": "boolean"},
        "review_timeout_seconds": {"type": "integer"},
        "registered_agents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "role"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,62}$"
              },
              "role": {
                "type": "string",
                "enum": ["prompt_and_audit", "code_implementation", "dual_role"]
              },
              "instruction": {"type": "string"},
              "comment": {"type": "string"},
              "enabled": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}


