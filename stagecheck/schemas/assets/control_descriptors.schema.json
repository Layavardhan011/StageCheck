{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StageCheck Control Descriptors Schemas",
  "definitions": {
    "stagecheck_root": {
      "type": "object",
      "required": ["stagecheck_root", "manifest_sha256"],
      "additionalProperties": false,
      "properties": {
        "stagecheck_root": {"type": "string"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidence_root": {
      "type": "object",
      "required": ["evidence_root"],
      "additionalProperties": false,
      "properties": {
        "evidence_root": {"type": "string"}
      }
    },
    "qualification_root": {
      "type": "object",
      "required": ["qualification_root"],
      "additionalProperties": false,
      "properties": {
        "qualification_root": {"type": "string"}
      }
    },
    "dispositions": {
      "type": "object",
      "required": ["schema_version", "dispositions"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"type": "string", "enum": ["2.0"]},
        "dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["task_id", "defect_id", "rationale", "authorized_by"],
            "additionalProperties": false,
            "properties": {
              "disposition_id": {"type": "string"},
              "task_id": {"type": "string"},
              "attempt": {"type": "integer", "minimum": 1},
              "attempt_index": {"type": "integer", "minimum": 1},
              "defect_id": {"type": "string"},
              "rule_id": {"type": "string"},
              "waived_rules": {
                "type": "array",
                "items": {"type": "string"}
              },
              "action": {"type": "string"},
              "status": {"type": "string", "enum": ["APPROVED", "REVOKED", "REJECTED", "EXPIRED"]},
              "repo": {"type": "string"},
              "rationale": {"type": "string"},
              "authorized_by": {"type": "string"},
              "authorized_role": {"type": "string"},
              "permissions": {
                "type": "array",
                "items": {"type": "string"}
              },
              "explicit_approval": {"type": "boolean"},
              "evidence": {"type": "string"},
              "evidence_path": {"type": "string"},
              "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "authorized_at": {"type": "string"},
              "expires_at": {"type": "string"},
              "revoked_at": {"type": ["string", "null"]},
              "revoked_by": {"type": ["string", "null"]},
              "revocation_reason": {"type": ["string", "null"]},
              "nonce": {"type": "string"},
              "waiver_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "consumed_at": {"type": ["string", "null"]},
              "consumed_task_id": {"type": ["string", "null"]},
              "consumed_attempt": {"type": ["integer", "null"]},
              "timestamp": {"type": "string"}
            }
          }
        }
      }
    }
  }
}

