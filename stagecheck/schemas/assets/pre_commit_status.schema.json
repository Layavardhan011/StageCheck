{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StageCheck Pre-Commit Status Request Schema",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "attempt",
    "cycle",
    "status",
    "touched_repositories"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0", "2.0", "2.0.0"]
    },
    "task_id": {
      "type": "string",
      "pattern": "^task-[a-zA-Z0-9_-]+$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "cycle": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": ["AWAITING_REVIEW", "IN_REVISION"]
    },
    "touched_repositories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "base_commits": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "summary": {
      "type": "string"
    }
  }
}

